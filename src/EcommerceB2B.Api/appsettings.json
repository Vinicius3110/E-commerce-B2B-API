{
  // ─────────────────────────────────────────────────────────
  // 1. Configuracao da string de conexao com o banco de dados PostgreSQL
  // ─────────────────────────────────────────────────────────
  // Host=localhost: o PostgreSQL esta rodando na maquina local
  // Port=5432: porta padrao do PostgreSQL
  // Database=EcommerceB2B: nome do banco de dados da aplicacao (ambiente produtivo)
  // Username e Password: credenciais de acesso ao PostgreSQL local
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=EcommerceB2B;Username=postgres;Password=postgres"
  },

  // ─────────────────────────────────────────────────────────
  // 2. Configuracoes do JWT (JSON Web Token) para autenticacao da API
  // ─────────────────────────────────────────────────────────
  // Estas configuracoes sao vinculadas a classe JwtSettings via options pattern:
  //   services.Configure<JwtSettings>(configuration.GetSection("JwtSettings"))
  // O options pattern preenche automaticamente as propriedades da classe JwtSettings
  // com os valores definidos abaixo, mantendo a configuracao fortemente tipada
  "JwtSettings": {
    // Chave secreta usada para assinar digitalmente os tokens JWT
    // A assinatura garante que o token nao foi adulterado entre o cliente e o servidor
    // IMPORTANTE: Em producao, usar chave de 256+ bits armazenada em cofre de segredos
    // A string atual tem mais de 32 caracteres, atendendo ao requisito minimo do algoritmo HMAC-SHA256
    "Secret": "b3f8a2d1e9c74b5f8e0d6a3c9f2b7e4a1d8c5f0e3a6b9d2c7f4e1a8b5c0d3f6",

    // Emissor (issuer claim): identifica quem gerou o token JWT
    // O middleware de validacao confere se o token foi emitido por este emissor
    // Isso previne que tokens de outras aplicacoes sejam aceitos pela nossa API
    "Issuer": "EcommerceB2B.Api",

    // Audiencia (audience claim): identifica para quem o token e destinado
    // O middleware de validacao confere se o token foi criado para esta audiencia
    // Previne o uso indevido de tokens destinados a outros sistemas
    "Audience": "EcommerceB2B.Web",

    // Tempo de expiracao do access token em minutos
    // 60 minutos: equilibrio entre seguranca e usabilidade
    // Tokens muito curtos forcam refresh frequente; tokens muito longos sao risco de seguranca
    // Se um access token for roubado, o atacante tem no maximo 60 minutos para usa-lo
    "ExpirationMinutes": 60,

    // Tempo de expiracao do refresh token em dias
    // 7 dias: usuario pode renovar o access token por uma semana sem novo login
    // Apos expirar, o usuario precisa fazer login novamente com email e senha
    // Refresh tokens podem ser revogados pelo servidor em caso de suspeita de comprometimento
    "RefreshTokenExpirationDays": 7
  },

  // ─────────────────────────────────────────────────────────
  // 3. Configuracao de nivel de log da aplicacao
  // ─────────────────────────────────────────────────────────
  // Define quais mensagens serao registradas em cada componente do sistema
  // Niveis: Trace(0) < Debug(1) < Information(2) < Warning(3) < Error(4) < Critical(5) < None(6)
  // Apenas mensagens com nivel >= ao configurado serao exibidas
  "Logging": {
    "LogLevel": {
      // Log padrao para todos os componentes nao especificados abaixo
      // Information: registra eventos normais da aplicacao (requisicoes, operacoes)
      "Default": "Information",

      // Logs do framework ASP.NET Core
      // Warning: apenas avisos e erros, ignora logs informativos do framework
      // Isso reduz ruido no console sem perder informacoes importantes de diagnostico
      "Microsoft.AspNetCore": "Warning",

      // Logs do Entity Framework Core
      // Warning: apenas avisos e erros do ORM
      // LogInformation mostraria todas as queries SQL, o que poluiria o console em producao
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
