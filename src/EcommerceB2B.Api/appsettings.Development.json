{
  // ─────────────────────────────────────────────────────────
  // Configuracoes especificas do ambiente de Desenvolvimento
  // ─────────────────────────────────────────────────────────
  // Este arquivo complementa e sobrescreve appsettings.json no ambiente dev
  // O ASP.NET Core carrega primeiro appsettings.json e depois appsettings.{Environment}.json
  // Valores duplicados no arquivo de ambiente sobrescrevem os do arquivo base

  // Configuracao de log mais detalhada para desenvolvimento
  // Em dev, queremos ver mais informacoes para depuracao e aprendizado
  "Logging": {
    "LogLevel": {
      // Log padrao em desenvolvimento: nivel informativo
      "Default": "Information",

      // Em dev, vemos logs informativos do ASP.NET Core tambem
      // Isso ajuda a entender o pipeline de middleware e o roteamento
      "Microsoft.AspNetCore": "Information",

      // Exibe as queries SQL geradas pelo Entity Framework no console
      // IMPORTANTE para aprendizado: permite ver exatamente qual SQL o EF Core gera
      // Em producao, isso deveria ser removido por questoes de performance e seguranca
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  // String de conexao especifica para o banco de desenvolvimento
  // Database=EcommerceB2B_Dev: banco separado do ambiente produtivo
  // Isso evita que testes de desenvolvimento afetem dados reais
  // Manter bancos separados por ambiente e boa pratica de seguranca e isolamento
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=EcommerceB2B_Dev;Username=postgres;Password=postgres"
  }
}
